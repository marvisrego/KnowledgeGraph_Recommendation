# Required for full chat, retrieval, and reranking behavior
CHAT_MODEL_API_KEY=
EMBED_MODEL_API_KEY=
COHERE_RERANK_API_KEY=

# Optional model and endpoint overrides
CHAT_MODEL_ENDPOINT=https://career.azure-api.net/career-graph-ai/openai/v1/responses
CHAT_MODEL=gpt-4o-mini
EMBED_MODEL_ENDPOINT=https://career.azure-api.net/career-graph-ai
EMBED_MODEL=text-embedding-3-large
COHERE_RERANK_ENDPOINT=https://career.azure-api.net/career-graph-ai/providers/cohere/v2/rerank
COHERE_RERANK_MODEL=Cohere-rerank-v4.0-pro

# Dedicated cloud databases. Never commit populated values.
KG_URI=
KG_USER=
KG_PASS=
KG_ID=
# Leave empty to use the Aura instance's configured default database.
NEO4J_DATABASE=
VECTOR_ENDPOINT=
VECTOR_PASS=
QDRANT_COLLECTION=career_roles
NEO4J_BATCH_SIZE=1000
QDRANT_BATCH_SIZE=100

# Optional legacy/offline build paths (not used by the cloud runtime)
GRAPH_PATH=graph/graph.gpickle
CHROMA_DIR=index/chroma

# Optional retrieval and transition ranking controls
RETRIEVAL_TOP_K=50
RERANK_TOP_N=8
ONET_IMPORTANCE_THRESHOLD=3.5
TRANSITION_MIN_COUNT=5
TRANSITION_CANDIDATE_LIMIT=12
TRANSITION_TRAVERSAL_LIMIT=8
TRANSITION_SMOOTHING_ENABLED=true
TRANSITION_SMOOTHING_NEIGHBOURS=25
TRANSITION_SMOOTHING_DIRECT_WEIGHT=0.91
TRANSITION_SMOOTHING_TEMPERATURE=0.06
# Empty preserves the accepted fixed-weight smoother. Set after a validation-only
# empirical-Bayes search, e.g. 10, to use count-aware shrinkage.
TRANSITION_SMOOTHING_PRIOR_STRENGTH=

# Bundled model-predicted missing-edge backfill (virtual; never persisted to the KG)
LINK_PREDICTION_ENABLED=true
LINK_PREDICTION_MODEL_PATH=artifacts/link_prediction/link_predictor.json

# Empirically calibrated TES and promoted sequential ranking are optional.
EFFORT_CALIBRATION_PATH=artifacts/transition_effort/tes_calibration.json
SEQUENTIAL_RANKING_ENABLED=false
SEQUENTIAL_RANKING_ARTIFACT_PATH=artifacts/sequential_ranking/sequential_ranker.npz

# Optional LangGraph orchestration; classic and LangGraph use the same retriever
USE_LANGGRAPH=True
